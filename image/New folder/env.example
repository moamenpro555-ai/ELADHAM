# انسخ الملف ده باسم .env للتجربة المحلية فقط. على Render حط القيم في Environment Variables.
# ممنوع ترفع ملف .env على GitHub.

NODE_ENV=production
PORT=3000

# Supabase -> Connect -> Direct -> Session pooler (حط الباسورد مكان [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# عنوان موقعك على GitHub Pages (الـ origin بس، من غير / في الآخر ومن غير اسم المجلد)
CORS_ORIGINS=https://YOUR-USERNAME.github.io
FRONTEND_URL=https://YOUR-USERNAME.github.io/YOUR-REPO

# موقعك والـ API على دومينين مختلفين => none (محتاج HTTPS). لو نفس الدومين الرئيسي => lax
COOKIE_SAMESITE=none
TRUST_PROXY_HOPS=1

# سر لتوقيع روابط الفيديو: نص عشوائي طويل (32 حرف على الأقل)
VIDEO_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# أول حساب مدرس (بيتعمل مرة واحدة أول تشغيل لو الإيميل مش موجود). بعد ما تدخل ممكن تمسح الباسورد من Render
TEACHER_BOOTSTRAP_EMAIL=teacher@example.com
TEACHER_BOOTSTRAP_NAME=اسم المدرس
TEACHER_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
